  "posts": [
   {
    "url": "https://dos.usz.edu.pl/waska/zajecia-waska/2026/11/wyklad-ogolnouczelniany-bioterrorism-dr-inz-j-skorupski/",
    "title": "wykład ogólnouczelniany-Bioterrorism-dr inż. J. Skorupski",
    "ym": "2026-11",
    "pub": "2026-11-03",
    "text": "Zajęcia z przedmiotu Bioterrorism , zaplanowane na dzień 29.10.2026 r., w związku z nieprzewidzianą awarią komputera prowadzącego, nie mogły odbyć się w zaplanowanym terminie i zrealizowane zostaną w dn. 26.11.2026, w godz. 17:45-19:15, w trybie zdalnym."
   },
   {
    "url": "https://dos.usz.edu.pl/waska/2026/11/hydrobiology-1st-degree-3rd-year-classes-with-dr-j-skorupski-cancelled-on-3rd-november/",
    "title": "Hydrobiology 1st degree 3rd year – classes with dr J. Skorupski cancelled on 3rd November",
    "ym": "2026-11",
    "pub": "2026-11-03",
    "text": "Z powodu wyjazdu służbowego zajęcia z przedmiotu Phylogeny of water organisms, zaplanowane na 03.11.2026, odbędą się w dn. 06.11.2026, godz. 11:00-12:30, s. 112 (ul. Wąska 13). dr Jakub Skorupski"
   },
   {
    "url": "https://dos.usz.edu.pl/waska/2026/10/hydrobiology-i-degree-2-year-cancelled-ornithology-class-on-21st-oct/",
    "title": "Hydrobiology I degree 2 year – cancelled ornithology class on 21st Oct",
    "ym": "2026-10",
    "pub": "2026-10-20",
    "text": "Szanowni Państwo, z powodu zmiany prowadzącego jutrzejsze ćwiczenia (środa 21.10.2026) się nie odbędą i zostaną całkowicie przesunięte na pierwotny termin – wtorek o godzinie 8.15. Ciąg zajęć zakończy się tydzień później. dr hab. Łukasz Jankowiak, prof. US"
   },
   {
    "url": "https://dos.usz.edu.pl/waska/2026/10/hydrobiology-i-degree-1-year-vertebrate-zoology-lecture-on-wed-14th-oct/",
    "title": "Hydrobiology I degree 1 year – Vertebrate zoology lecture on Wed 14th Oct",
    "ym": "2026-10",
    "pub": "2026-10-12",
    "text": "Message from dr Michał Szkudlarek: As we already agreed, Friday’s meeting will be on Wednesday, starting at 12:00, room 323W ."
   },
   {
    "url": "https://dos.usz.edu.pl/waska/2026/10/hydrobiology-i-degree-2-year-canceled-climatology-classes-with-mgr-zofia-stachowska/",
    "title": "Hydrobiology I degree 2 year – cancelled climatology classes with mgr Zofia Stachowska",
    "ym": "2026-10",
    "pub": "2026-10-09",
    "text": "Szanowni Państwo, z powodu infekcji przebywam na zwolnieniu lekarskim do 14.10., wobec czego zajęcia planowane w dn, 13.10. nie odbędą się."
   }
