  "posts": [
   {
    "url": "https://dos.usz.edu.pl/cukrowa/2026/11/grupa-c211-c212-13/",
    "title": "GRUPA C211, C212",
    "ym": "2026-11",
    "pub": "2026-11-04",
    "text": "Dnia 17.11.2026 o godz. 15:30 w sali SIL 325 odbędzie się odrabianie zajęć z dr inż. Anną Borawską z dnia 07.10.2026 r."
   },
   {
    "url": "https://dos.usz.edu.pl/cukrowa/2026/11/grupa-c211-c212-12/",
    "title": "GRUPA C211, C212",
    "ym": "2026-11",
    "pub": "2026-11-03",
    "text": "Dnia 13.11.2026 zostają odwołane zajęcia z dr Iloną Kędzierską-Bujak. Termin odrobienia zajęć: 04.12.2026 godz. 13:45 sala 003 „Fundamentals of accounting” lacture with dr Ilona Kędzierska-Bujak from 13rd December is reschedule for 4th December at 13:45 and 003 classroom."
   },
   {
    "url": "https://dos.usz.edu.pl/cukrowa/2026/11/grupa-c211-c212-11/",
    "title": "GRUPA C211, C212",
    "ym": "2026-11",
    "pub": "2026-11-03",
    "text": "Dnia 03.11.2026 zostają odwołane zajęcia z dr Moniką Klein. Termin odrobienia zostanie ustalony na kolejnych zajęciach. Dear Students, Today’s class (3 November) is cancelled. We will see each other at our next scheduled class, when we will also agree on a date to make up the missed hours. Best regards, Dr Monika Klein"
   },
   {
    "url": "https://dos.usz.edu.pl/cukrowa/2026/10/grupa-c211-c212-10/",
    "title": "GRUPA C211, C212",
    "ym": "2026-10",
    "pub": "2026-10-26",
    "text": "Wykład z przedmiotu Business Process Modelling (Modelowanie procesów biznesowych) , odwołany w dniu 7 października 2026 r., zostanie odrobiony w terminie uzgodnionym ze studentami, tj. 3 listopada 2026 r. (wtorek) w godz. 15:30–17:00, w sali SIL325 (kampus Cukrowa) . The Business Process Modelling lecture cancelled on 7 October 2026 will be made up on Tuesday, 3 November 2026, from 15:30 to 17:00, in room SIL325 (Cukrowa campus) , as agreed with the students."
   },
   {
    "url": "https://dos.usz.edu.pl/cukrowa/2026/10/grupa-c212-4/",
    "title": "GRUPA C212",
    "ym": "2026-10",
    "pub": "2026-10-23",
    "text": "Dnia 11.12.2026 zostają odwołane zajęcia z dr Krzysztofem Dmytrów. Termin odrobienia zajęć 12.11.2026 godz. 13:45 sala SIL 145/146 Termin odrobienia zajęć z dnia 02.10.2026: 12.11.2026 godz. 15:30 sala SIL 145/146 Catch-up lectures from October 2nd, 2026"
   },
   {
    "url": "https://dos.usz.edu.pl/cukrowa/2026/10/grupa-c211-c212-9/",
    "title": "GRUPA C211, C212",
    "ym": "2026-10",
    "pub": "2026-10-23",
    "text": "Dnia 11.12.2026 zostają odwołane zajęcia z dr Krzysztofem Dmytrów. Termin odrabiania wykładu: 29.10.2026 godz. 13:45 sala 002 Termin odrabiania wykładu z dnia 02.10.2026: 29.10.2026 godz. 15:30 sala 002 Catch-up lectures from October 2nd, 2026"
   },
   {
    "url": "https://dos.usz.edu.pl/cukrowa/2026/10/c211-zmiana-w-planie-sroda-parzysta/",
    "title": "C211 ZMIANA W PLANIE ŚRODA PARZYSTA",
    "ym": "2026-10",
    "pub": "2026-10-13",
    "text": "Nastąpiła zmiana w planie w środę parzystą bardzo proszę o zapoznanie się z nowym planem zajęć. GODZ. 8:15 CONSUMER BEHAVIOUR (ZACHOWANIA KONSUMENTÓW) (LB) GRUPA A"
   },
   {
    "url": "https://dos.usz.edu.pl/cukrowa/2026/10/grupa-c211-grupa-a/",
    "title": "GRUPA C211 grupa A",
    "ym": "2026-10",
    "pub": "2026-10-09",
    "text": "Dnia 13.10.2026 zostają odwołane zajęcia grupa A z mgr Mateuszem Mostowskim Termin odrobienia zostanie ustalony na kolejnych zajęciach. Dear Students, as I will be away on a business trip to attend a conference from 13 to 17 October, our classes (group A labs) will not take place. We will agree on a date to make them up together at our next meeting. Best regards!"
   },
   {
    "url": "https://dos.usz.edu.pl/cukrowa/2026/10/grupa-c211-c212-8/",
    "title": "GRUPA C211, C212",
    "ym": "2026-10",
    "pub": "2026-10-06",
    "text": "Dnia 07.10.2026 zostają odwołane zajęcia z dr inż. Anną Borawską Termin odrobienia zostanie ustalony na kolejnych zajęciach."
   }
